__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Chroma database: the built index IS committed (data/rag_documents/chroma_db/) so a
# fresh clone works without rebuilding it. Only temporary rebuild/backup copies are ignored.
data/rag_documents/chroma_db_rebuild/
data/rag_documents/chroma_db_old/

# Private local account and encrypted conversation data
data/auth/
data/private_conversations/
data/.chat_storage.key

# Legacy pre-encryption conversation storage (plaintext, real user data) — dead code path,
# never delete/rename, just never push it.
data/conversations/

# Trained model weights: the deployed model.safetensors IS committed, via Git LFS
# (see .gitattributes) since it is >100MB — a fresh clone needs no separate training step.
# Full training checkpoints (weights + optimizer state, >800MB each) are NOT needed at
# runtime and stay excluded, along with any nested .bin/.pt files they contain.
models/camembert_classifier/checkpoint-*/
models/camembert_classifier/runs/
models/camembert_classifier/**/*.bin
models/camembert_classifier/**/*.pt

# Local-only backup snapshots of the model (own README says "do NOT commit binary model
# files") — never intended to be committed, and contain multi-GB checkpoint/optimizer files
# that would exceed GitHub's 100MB hard file-size limit.
models/camembert_classifier_frozen_*/

# Leftover LaTeX/PDF export artifacts (auto-generated temp folders, random hash names)
media-*/

# Logs
logs/
*.log

# Notebooks checkpoints
notebooks/.ipynb_checkpoints/
.ipynb_checkpoints/

# Test / lint / coverage artifacts
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Scratch/temp working directory (smoke tests, ad-hoc tmp dirs)
.tmp/

# OS
.DS_Store
Thumbs.db
