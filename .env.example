# ── Required ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Model settings ─────────────────────────────────────────────────────────────
OPENAI_MODEL=gpt-4o-mini
# Local embedding model — no API cost, multilingual, works well for French medical text
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ── Paths (relative to project root) ───────────────────────────────────────────
CHROMA_PATH=data/chroma_db
CLASSIFIER_PATH=models/camembert_classifier
DOCUMENTS_PATH=data/documents
DATASET_PATH=data/questions_dataset
LOG_DIR=logs

# ── Safety thresholds ──────────────────────────────────────────────────────────
CAMEMBERT_CONFIDENCE_THRESHOLD=0.70
CHROMA_TOP_K=5
MEMORY_MAX_TURNS=3
