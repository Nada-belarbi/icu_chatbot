# ── Required ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Conversation storage encryption (optional for local dev) ──────────────────
# Fernet key used to encrypt saved conversations at rest. If unset, a local
# development key is auto-generated at data/.chat_storage.key on first run —
# do NOT rely on that fallback for a shared or production deployment.
# Generate a real key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CHAT_STORAGE_KEY=

# ── Model settings ─────────────────────────────────────────────────────────────
OPENAI_MODEL=gpt-4o-mini
# Local embedding model — no API cost, multilingual, works well for French medical text
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CLASSIFIER_PATH=models/camembert_classifier

# ── Paths (relative to project root) ───────────────────────────────────────────
CHROMA_PATH=data/rag_documents/chroma_db
CHROMA_COLLECTION_NAME=icu_documents
RAG_DOCUMENTS_PATH=data/rag_documents/raw
DOCUMENTS_PATH=data/documents
DATASET_PATH=data/questions_dataset
LOG_DIR=logs

# ── Safety thresholds ──────────────────────────────────────────────────────────
CAMEMBERT_CONFIDENCE_THRESHOLD=0.70
CHROMA_TOP_K=8
MEMORY_MAX_TURNS=3

# ── Chunking (used when building the Chroma index) ────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=50

